# =============================================================================
# Multi-User Isolated Web Terminal Platform - Backend Environment
# Copy this file to .env and adjust for your deployment.
# =============================================================================

# --- Server ---
HOST=0.0.0.0
PORT=8000
WORKERS=1
DEBUG=false

# --- Security ---
# Secret used to sign session cookies and JWTs. Generate a strong random value.
SECRET_KEY=change-me-to-a-strong-random-secret
# Session cookie lifetime in seconds (default 24 hours)
SESSION_TTL_SECONDS=86400
# JWT WebSocket upgrade token lifetime in seconds (short-lived)
WS_TOKEN_TTL_SECONDS=900

# --- Trusted proxies ---
# Comma-separated list of CIDRs/IPs allowed to set X-Forwarded-For.
# Set this to your reverse proxy's IP(s). Leave empty to trust NO forwarding headers.
TRUSTED_PROXIES=127.0.0.1,::1

# --- Database ---
DB_PATH=data/terminal_panel.db

# --- Docker / container isolation ---
# Docker daemon socket. Default is the local unix socket.
DOCKER_HOST=unix:///var/run/docker.sock
# Image used for isolated user terminals.
TERMINAL_IMAGE=ubuntu:22.04
# Whether container orchestration is enabled. Set false to run without Docker (dev only).
DOCKER_ENABLED=true

# --- System-wide resource limits (defaults; admins can override per-user) ---
DEFAULT_RAM_LIMIT_MB=512
DEFAULT_CPU_LIMIT=1.0
DEFAULT_DISK_LIMIT_MB=2048
DEFAULT_PIDS_LIMIT=64
DEFAULT_MAX_SESSIONS=2
DEFAULT_MAX_SESSION_DURATION_SECONDS=28800
DEFAULT_IDLE_TIMEOUT_SECONDS=1800
DEFAULT_MAX_CMD_TIME_SECONDS=120
MAX_CONCURRENT_USERS=2000

# --- Rate limiting ---
LOGIN_RATE_LIMIT=5            # requests per window
LOGIN_RATE_WINDOW_SECONDS=60
REGISTER_RATE_LIMIT=3         # requests per window
REGISTER_RATE_WINDOW_SECONDS=60
WS_RATE_LIMIT=10              # connections per window
WS_RATE_WINDOW_SECONDS=60

# --- CORS / origins ---
# Comma-separated allowed origins for the admin/user dashboards.
CORS_ORIGINS=http://localhost:3000,https://your-domain.com

# --- Admin bootstrap ---
# First admin account created on startup if ADMIN_EMAIL is set.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-immediately
ADMIN_USERNAME=admin
